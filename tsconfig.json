{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2022", "dom"],
    "rootDir": "src",
    "outDir": "lib",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [],
    "declaration": false,
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/client"]
}
